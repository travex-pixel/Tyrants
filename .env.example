# ─────────────────────────────────────────────────────────────────────────────
# LITTLE TYRANTS — environment variables
#
# Solo World, Creative Sandbox and Challenges work with NO variables at all.
# The two Supabase values below switch on "Play with Friends" (multiplayer).
# Both are safe to expose to the browser (they are the public "anon" pair);
# access is restricted by the Row Level Security policies in supabase/migrations.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL  (Supabase dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Supabase dashboard → Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the public URL of your deployment, used to build invite links
# (falls back to window.location.origin when empty)
NEXT_PUBLIC_SITE_URL=
